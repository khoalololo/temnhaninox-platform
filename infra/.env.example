# Copy to infra/.env (git-ignored) and fill in. Never commit real values.
# Local dev works without any of this (Spring "dev" profile has defaults).
# Production: run services with SPRING_PROFILES_ACTIVE=prod -> they refuse to start if any of these are missing.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=temnhaninox_db

# Must be identical for api-gateway and auth-service; >= 64 random chars (e.g. `openssl rand -base64 64`)
JWT_SECRET=

# First ADMIN account, created only if no admin exists yet. Change the password after first login.
ADMIN_EMAIL=admin@temnhaninox.com
ADMIN_PASSWORD=

S3_ACCESS_KEY=
S3_SECRET_KEY=

# VNPAY: register https://<your-public-host>/api/v1/payments/vnpay-ipn as the IPN URL in the merchant portal
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Where VNPAY sends the browser back (must be reachable from the browser) and the sandbox pay page
VNPAY_RETURN_URL=http://localhost:4200/payment/vnpay-return
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public URL of the storefront (used in password-reset links)
FRONTEND_URL=http://localhost:4200
# Google OAuth Web client ID (blank = Google button hidden/disabled). Also paste it into frontend/src/app/core/config/app-config.ts
GOOGLE_CLIENT_ID=
# SMTP (docker-compose provides Mailpit for dev: UI http://localhost:8025). Production: real SMTP.
MAIL_HOST=
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@temnhaninox.com
