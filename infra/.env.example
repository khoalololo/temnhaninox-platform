# Copy to infra/.env (git-ignored) and fill in. Never commit real values.
# Local dev works without any of this (Spring "dev" profile has defaults).
# Production: run services with SPRING_PROFILES_ACTIVE=prod -> they refuse to start if any of these are missing.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=temnhaninox_db

# Must be identical for api-gateway and auth-service; >= 64 random chars (e.g. `openssl rand -base64 64`)
JWT_SECRET=

# First ADMIN account, created only if no admin exists yet. Change the password after first login.
ADMIN_EMAIL=admin@temnhaninox.com
ADMIN_PASSWORD=

S3_ACCESS_KEY=
S3_SECRET_KEY=

# VNPAY: register https://<your-public-host>/api/v1/payments/vnpay-ipn as the IPN URL in the merchant portal
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
